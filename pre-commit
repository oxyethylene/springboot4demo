#!/bin/bash

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Get list of staged files
staged_files=$(git diff --cached --name-only --diff-filter=ACM)

# Exit if no files staged
if [ -z "$staged_files" ]; then
    echo -e "${GREEN}✓ No files to check${NC}"
    exit 0
fi

# Track if any check fails
has_errors=0

# ============================================
# 1. Check for merge conflict markers
# ============================================
echo -n "Checking for merge conflict markers...  "
conflict_markers=$(echo "$staged_files" | xargs grep -l "^<<<<<<< \|^======= \|^>>>>>>> " 2>/dev/null)

if [ -n "$conflict_markers" ]; then
    echo -e "${RED}✗${NC}"
    echo -e "${RED}❌ Merge conflict markers found: ${NC}"
    echo "$conflict_markers"
    has_errors=1
else
    echo -e "${GREEN}✓${NC}"
fi

# ============================================
# 2. Check for console.log / debugger
# ============================================
echo -n "Checking for debug statements... "
js_ts_files=$(echo "$staged_files" | grep -E '\.(js|jsx|ts|tsx)$')

if [ -n "$js_ts_files" ]; then
    debug_statements=$(echo "$js_ts_files" | xargs grep -n "console\. log\|debugger" 2>/dev/null)
    
    if [ -n "$debug_statements" ]; then
        echo -e "${YELLOW}⚠${NC}"
        echo -e "${YELLOW}⚠️  Warning: Debug statements found:${NC}"
        echo "$debug_statements"
        # Just warn, don't fail (you might want to change this)
    else
        echo -e "${GREEN}✓${NC}"
    fi
else
    echo -e "${GREEN}✓${NC} (no JS/TS files)"
fi

# ============================================
# 3. Check for TODO/FIXME without issue number
# ============================================
echo -n "Checking for TODOs without issue numbers... "
todos=$(echo "$staged_files" | xargs grep -n "TODO\|FIXME" 2>/dev/null | grep -v "#[0-9]")

if [ -n "$todos" ]; then
    echo -e "${YELLOW}⚠${NC}"
    echo -e "${YELLOW}⚠️  Warning: TODO/FIXME without issue reference:${NC}"
    echo "$todos"
    echo -e "${YELLOW}   Use format: TODO(#123): description${NC}"
else
    echo -e "${GREEN}✓${NC}"
fi

# ============================================
# 4. Check file size (prevent large files)
# ============================================
echo -n "Checking file sizes... "
max_file_size=1048576  # 1MB in bytes

large_files=$(echo "$staged_files" | while read file; do
    if [ -f "$file" ]; then
        size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null)
        if [ "$size" -gt "$max_file_size" ]; then
            echo "$file ($size bytes)"
        fi
    fi
done)

if [ -n "$large_files" ]; then
    echo -e "${RED}✗${NC}"
    echo -e "${RED}❌ Large files detected (>1MB):${NC}"
    echo "$large_files"
    echo "Consider using Git LFS for large files"
    has_errors=1
else
    echo -e "${GREEN}✓${NC}"
fi

# ============================================
# 5. Run ESLint (if available)
# ============================================
if command -v npm &> /dev/null && [ -f "package.json" ]; then
    if npm run lint --silent &> /dev/null; then
        echo -n "Running ESLint... "
        
        # Check if there are JS/TS files to lint
        if [ -n "$js_ts_files" ]; then
            if npm run lint -- $js_ts_files 2>&1 | grep -q "error"; then
                echo -e "${RED}✗${NC}"
                echo -e "${RED}❌ ESLint errors found.  Run 'npm run lint' to see details${NC}"
                has_errors=1
            else
                echo -e "${GREEN}✓${NC}"
            fi
        else
            echo -e "${GREEN}✓${NC} (no files to lint)"
        fi
    fi
fi

# ============================================
# 6. Run Prettier (if available)
# ============================================
if command -v npx &> /dev/null && [ -f ". prettierrc" ] || [ -f ". prettierrc.json" ]; then
    echo -n "Checking code formatting... "
    
    unformatted=$(echo "$staged_files" | xargs npx prettier --check 2>/dev/null)
    
    if [ $? -ne 0 ]; then
        echo -e "${YELLOW}⚠${NC}"
        echo -e "${YELLOW}⚠️  Warning:  Code not formatted.  Run 'npm run format'${NC}"
        # Uncomment to auto-format: 
        # echo "$staged_files" | xargs npx prettier --write
        # echo "$staged_files" | xargs git add
    else
        echo -e "${GREEN}✓${NC}"
    fi
fi

# ============================================
# 7. Check for secrets/credentials
# ============================================
echo -n "Checking for secrets...  "
secrets=$(echo "$staged_files" | xargs grep -iE "password\s*=|api_key\s*=|secret\s*=|token\s*=" 2>/dev/null | grep -v "password:  ''" | grep -v "# password")

if [ -n "$secrets" ]; then
    echo -e "${RED}✗${NC}"
    echo -e "${RED}❌ Possible secrets detected:${NC}"
    echo "$secrets"
    echo -e "${RED}   Please remove secrets before committing! ${NC}"
    has_errors=1
else
    echo -e "${GREEN}✓${NC}"
fi

# ============================================
# Final Result
# ============================================
echo ""
if [ $has_errors -eq 1 ]; then
    echo -e "${RED}❌ Pre-commit checks failed!${NC}"
    echo -e "${YELLOW}Fix the errors above and try again.${NC}"
    echo ""
    exit 1
else
    echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
    echo ""
    exit 0
fi

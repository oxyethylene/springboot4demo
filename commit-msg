#!/bin/bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Conventional commit pattern
# Format: type(scope): subject
# Example: feat(auth): add login functionality
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?: .{1,50}'

# Allow merge commits
if echo "$commit_msg" | grep -qE "^Merge branch"; then
    exit 0
fi

# Allow revert commits
if echo "$commit_msg" | grep -qE "^Revert \""; then
    exit 0
fi

# Check if commit message matches pattern
if !  echo "$commit_msg" | grep -qE "$pattern"; then
    echo -e "${RED}❌ Invalid commit message format! ${NC}"
    echo ""
    echo -e "${YELLOW}Your commit message: ${NC}"
    echo "  $commit_msg"
    echo ""
    echo -e "${YELLOW}Required format:${NC}"
    echo "  type(scope): subject"
    echo ""
    echo -e "${YELLOW}Valid types:${NC}"
    echo "  feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
    echo ""
    echo -e "${YELLOW}Examples:${NC}"
    echo "  ${GREEN}feat(auth): add user login${NC}"
    echo "  ${GREEN}fix(api): resolve null pointer exception${NC}"
    echo "  ${GREEN}docs:  update README installation steps${NC}"
    echo ""
    echo -e "${YELLOW}Rules:${NC}"
    echo "  - Subject must be 1-50 characters"
    echo "  - Use imperative mood ('add' not 'added')"
    echo "  - No period at the end"
    echo "  - Lowercase subject"
    echo ""
    exit 1
fi

# Check subject length
subject=$(echo "$commit_msg" | head -n1 | sed -E 's/^[^: ]+:  //')
subject_length=${#subject}

if [ $subject_length -gt 72 ]; then
    echo -e "${RED}❌ Commit subject too long!${NC}"
    echo "  Length: $subject_length characters (max 72)"
    echo "  Subject: $subject"
    exit 1
fi

# Check for uppercase first letter in subject (should be lowercase)
if echo "$subject" | grep -qE '^[A-Z]'; then
    echo -e "${YELLOW}⚠️  Warning: Subject should start with lowercase${NC}"
    echo "  Current: $subject"
    # Just warn, don't fail
fi

# Check for period at end (shouldn't have one)
if echo "$subject" | grep -qE '\.$'; then
    echo -e "${YELLOW}⚠️  Warning: Remove period at end of subject${NC}"
    echo "  Current: $subject"
    # Just warn, don't fail
fi

echo -e "${GREEN}✓ Commit message format valid${NC}"
exit 0
